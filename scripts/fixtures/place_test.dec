Actor TestBarrel : Barrel
{
	+NOBLOOD
	Health 40
	States
	{
	Spawn:
		BARL A 140
		BARL B 6 A_FaceTarget
		Loop
	Death:
		"****" A 8 Bright A_Explode(128, 100)
		"****" B 6
		Stop
	}
}

Actor TestWeapon : Weapon
{
	+WEAPON.NOAUTOAIM
	States {
	Ready:
		TNT1 A 1 A_WeaponReady
		Loop
	Raise:
		TNT1 A 0 {
			A_SetRoll(0);
			A_Raise();
		}
		TNT1 A 1 A_Lower
		Goto Selected
	}
}

Actor NoStatesHere : Actor
{
	Health 5
	+FLOAT
}
