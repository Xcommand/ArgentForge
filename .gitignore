################################################################################
# This .gitignore file was automatically created by Microsoft(R) Visual Studio.
################################################################################

.*.sw*
*.sdf
*.suo
*.opensdf
*.obj
*.tlog
*.opendb
*.db
*.ipch
*.pch
*.user
*.tmp
/*.ncb
/.vscode/*
/release
/build
/.cache
/dist/*.log
/dist/*.map
/dist/portable
/dist/res/.vscode/*
/docs/build/
/ipch
/src/build/
/src/bzip2/Release
/src/lzma/Release
/src/zlib/Release
/src/updaterevision
/src/gitinfo.h
/win_installer/Output
/cmake-build-*
/.idea/
/msvc/.vs
/msvc/x64/
/.vs
/out/

/dist/*
!/dist/res
!/dist/CMakeLists.txt
!/dist/makebuild.ps1

CMakeSettings.json
CMakeUserPresets.json

# What a Windows build leaves behind: the dependencies vcpkg unpacks, and the logs of one-off
# configure and install runs. None of it is a source, and the folder alone is gigabytes.
/vcpkg_installed/
/*.log

# Upstream's Inno Setup scripts. They take dist\build64\SLADE.exe, which this build never produces
# (ours is dist\ArgentForge.exe), so they build nothing and only mislead the reader.
/win_installer/

# CMake build output for the vendored libraries; the sources above it are ours to track, this is not.
/thirdparty/build/

# The packing helper dist/CMakeLists.txt calls. It lives in a folder the build fills, so it needs naming rather than the wildcard.
!/dist/7z_command.cmake

# A stray VSCode task file the editor dropped next to the vendored libraries.
/thirdparty/.vscode/

# Linker and debug leftovers. The builds that make them live in ignored folders today, but a stray .pdb or
# .ilk anywhere else should not be able to reach a commit by accident.
*.pdb
*.ilk
*.exp
*.idb

# A cmake configure that ran in the repo root instead of out/build/win-x64-release. The real cache is
# in that folder, so these are leftovers of a mistyped command rather than a second build.
/CMakeCache.txt
/CMakeFiles/

# Tool state that belongs to nobody in the project: the editor's own folder, the wiki Qoder generates
# from the code, and the ignore file it writes for itself. All three regenerate, none of them is source.
/.continue/
/.qoder/
/.qoderignore

# The agent's own note on where the authoritative tree is and which disk it lives on. Local by
# definition, and it names paths that belong to one machine
/AGENTS.md
