
styleset
{
	name = "Argent (Dark)";

	default
	{
		size = 10;
		foreground = 232, 230, 228;
		background = 28, 24, 25;
		bold = false;
		italic = false;
		underlined = false;
	}

	selection
	{
		background = 45, 58, 84;
	}

	preprocessor
	{
		foreground = 116, 132, 156;
	}

	comment
	{
		foreground = 108, 134, 112;
		italic = 1;
	}

	comment_doc
	{
		foreground = 112, 148, 164;
		italic = 1;
	}

	string
	{
		foreground = 224, 96, 74;
	}

	character
	{
		foreground = 232, 132, 96;
	}

	keyword
	{
		foreground = 236, 186, 62;
	}

	constant
	{
		foreground = 128, 206, 148;
	}

	type
	{
		foreground = 96, 168, 232;
	}

	property
	{
		foreground = 140, 196, 236;
	}

	function
	{
		foreground = 240, 208, 116;
	}

	number
	{
		foreground = 104, 214, 156;
	}

	operator
	{
		foreground = 196, 178, 120;
	}

	bracematch
	{
		background = 34, 82, 56;
		bold = 1;
	}

	bracebad
	{
		background = 122, 40, 32;
		bold = 1;
	}

	linenum
	{
		foreground = 148, 132, 96;
		background = 34, 29, 30;
	}

	calltip
	{
		foreground = 232, 230, 228;
		background = 42, 36, 38;
	}

	calltip_hl
	{
		foreground = 236, 186, 62;
		bold = 1;
	}

	foldmargin
	{
		foreground = 128, 114, 82;
		background = 34, 29, 30;
	}

	guides
	{
		foreground = 60, 66, 84;
	}

	wordmatch
	{
		foreground = 96, 168, 232;
	}

	current_line
	{
		foreground = 148, 132, 96;
		background = 37, 31, 32;
	}
}
