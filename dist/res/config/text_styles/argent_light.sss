
styleset
{
	name = "Argent (Light)";

	default
	{
		size = 10;
		foreground = 56, 50, 46;
		background = 250, 247, 242;
		bold = false;
		italic = false;
		underlined = false;
	}

	selection
	{
		background = 206, 222, 238;
	}

	preprocessor
	{
		foreground = 150, 116, 44;
	}

	comment
	{
		foreground = 104, 124, 100;
		italic = 1;
	}

	comment_doc
	{
		foreground = 78, 112, 140;
		italic = 1;
	}

	string
	{
		foreground = 178, 48, 30;
	}

	character
	{
		foreground = 196, 84, 50;
	}

	keyword
	{
		foreground = 20, 84, 148;
	}

	constant
	{
		foreground = 156, 110, 16;
	}

	type
	{
		foreground = 140, 94, 26;
	}

	property
	{
		foreground = 18, 112, 84;
	}

	function
	{
		foreground = 126, 84, 10;
	}

	number
	{
		foreground = 26, 124, 72;
	}

	operator
	{
		foreground = 82, 74, 68;
	}

	bracematch
	{
		background = 200, 234, 212;
		bold = 1;
	}

	bracebad
	{
		background = 250, 196, 182;
		bold = 1;
	}

	linenum
	{
		foreground = 122, 108, 96;
		background = 238, 232, 222;
	}

	calltip
	{
		foreground = 40, 36, 32;
		background = 248, 244, 236;
	}

	calltip_hl
	{
		foreground = 126, 84, 10;
		bold = 1;
	}

	foldmargin
	{
		foreground = 138, 124, 110;
		background = 238, 232, 222;
	}

	guides
	{
		foreground = 214, 204, 190;
	}

	wordmatch
	{
		foreground = 20, 84, 148;
	}

	current_line
	{
		foreground = 122, 108, 96;
		background = 246, 242, 234;
	}
}
